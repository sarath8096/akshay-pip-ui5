<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <VBox id="tasksSectionBox">
        <Toolbar id="tasksToolbar">
            <Title id="tasksToolbarTitle" text="{i18n>detailTasksSectionTitle}" />
            <ToolbarSpacer id="tasksToolbarSpacer" />
            <Button
                id="btnEditTasks"
                text="{i18n>btnEditProject}"
                type="Transparent"
                visible="{= !${mProjectDetail>/tab/tasks/isEdit} }"
                press="onEditTasks" />
            <Button
                id="btnSaveTasks"
                text="{i18n>btnSaveProject}"
                type="Transparent"
                visible="{mProjectDetail>/tab/tasks/isEdit}"
                press="onSaveTasks" />
            <Button
                id="btnCancelTasks"
                text="{i18n>btnCancelProject}"
                type="Transparent"
                visible="{mProjectDetail>/tab/tasks/isEdit}"
                press="onCancelTasks" />
        </Toolbar>
        <List id="tasksList" items="{mProjectDetail>/tab/tasks/list}" noDataText="{i18n>projectListNoDataText}">
            <CustomListItem id="taskItem">
                <HBox id="taskItemBox" justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMargin">
                    <VBox id="taskInfoBox">
                        <Text id="taskAssigneeText" text="{mProjectDetail>assignee/name}" visible="{= !${mProjectDetail>isEditable} }" />
                        <Select id="taskAssigneeSelect" items="{mProjectDetail>/owners}" selectedKey="{mProjectDetail>assignee_ID}" visible="{= !!${mProjectDetail>isEditable} }">
                            <core:Item id="taskAssigneeItem" key="{mProjectDetail>ID}" text="{mProjectDetail>name}" />
                        </Select>
                    </VBox>
                    <ObjectStatus
                        id="taskStatusText"
                        text="{mProjectDetail>status}"
                        state="{ path: 'mProjectDetail>status', formatter: '.formatter.formatTaskStatusState' }"
                        visible="{= !${mProjectDetail>isEditable} }" />
                    <Select id="taskStatusSelect" selectedKey="{mProjectDetail>status}" visible="{= !!${mProjectDetail>isEditable} }">
                        <core:Item id="taskStatusOpen" key="Open" text="{i18n>taskStatusOpen}" />
                        <core:Item id="taskStatusInProgress" key="In Progress" text="{i18n>taskStatusInProgress}" />
                        <core:Item id="taskStatusDone" key="Done" text="{i18n>taskStatusDone}" />
                    </Select>
                </HBox>
            </CustomListItem>
        </List>
    </VBox>
</core:FragmentDefinition>
