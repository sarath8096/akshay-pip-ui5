<mvc:View controllerName="com.projectone.projectoneui.controller.list.ProjectList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Table
            id="projectTable"
            items="{project>/ProjectsList}"
            noDataText="{i18n>projectListNoDataText}"
            growing="true"
            growingScrollToLoad="true"
            growingThreshold="20"
            sticky="HeaderToolbar,ColumnHeaders">
            <headerToolbar>
                <Toolbar id="tableHeaderToolbar">
                    <Title id="tableTitle" text="{i18n>projectListTableTitle}" level="H2" />
                    <ToolbarSpacer id="tableHeaderSpacer" />
                    <SearchField id="projectSearchField" width="20rem" placeholder="{i18n>searchFieldPlaceholder}" search="onSearch" liveChange="onSearch" />
                    <Button id="btnSort" icon="sap-icon://sort" tooltip="{i18n>btnSortTooltip}" press="onSortButtonPress" />
                </Toolbar>
            </headerToolbar>
            <columns>
                <Column id="colName">
                    <Text id="colNameText" text="{i18n>columnName}" />
                </Column>
                <Column id="colStatus">
                    <Text id="colStatusText" text="{i18n>columnStatus}" />
                </Column>
                <Column id="colOwner">
                    <Text id="colOwnerText" text="{i18n>columnOwner}" />
                </Column>
                <Column id="colPriority">
                    <Text id="colPriorityText" text="{i18n>columnPriority}" />
                </Column>
                <Column id="colStartDate">
                    <Text id="colStartDateText" text="{i18n>columnStartDate}" />
                </Column>
                <Column id="colEndDate">
                    <Text id="colEndDateText" text="{i18n>columnEndDate}" />
                </Column>
                <Column id="colProgress" hAlign="End">
                    <Text id="colProgressText" text="{i18n>columnProgress}" />
                </Column>
            </columns>
            <items>
                <ColumnListItem id="projectListItem" type="Navigation" press="onProjectPress">
                    <cells>
                        <ObjectIdentifier id="cellName" title="{project>name}" />
                        <ObjectStatus
                            id="cellStatus"
                            text="{project>status}"
                            state="{ path: 'project>status', formatter: '.formatter.formatStatusState' }" />
                        <Text id="cellOwner" text="{project>ownerName}" />
                        <ObjectStatus
                        id="cellPriority"
                        text="{project>priority}"
                        icon="{path: 'project>priority', formatter: '.formatter.fnGetPriorityIconByCode'}"
                        state="{path: 'project>priority', formatter: '.formatter.fnGetPriorityStateByCode'}" />
                        <Text id="cellStartDate" text="{ path: 'project>startDate', formatter: '.formatter.formatDate' }" />
                        <Text id="cellEndDate" text="{ path: 'project>endDate', formatter: '.formatter.formatDate' }" />
                        <ProgressIndicator
                            id="cellProgress"
                            percentValue="{project>progress}"
                            displayValue="{project>progress}%"
                            showValue="true" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <dependents>
            <ViewSettingsDialog id="sortDialog" confirm="onSortConfirm">
                <sortItems>
                    <ViewSettingsItem id="sortItemName" key="name" text="{i18n>columnName}" />
                    <ViewSettingsItem id="sortItemStatus" key="status" text="{i18n>columnStatus}" />
                    <ViewSettingsItem id="sortItemOwner" key="ownerName" text="{i18n>columnOwner}" />
                    <ViewSettingsItem id="sortItemPriority" key="priority" text="{i18n>columnPriority}"  />
                    <ViewSettingsItem id="sortItemStartDate" key="startDate" text="{i18n>columnStartDate}" />
                    <ViewSettingsItem id="sortItemEndDate" key="endDate" text="{i18n>columnEndDate}" />
                    <ViewSettingsItem id="sortItemProgress" key="progress" text="{i18n>columnProgress}" />
                </sortItems>
            </ViewSettingsDialog>
        </dependents>
    </Page>
</mvc:View>
