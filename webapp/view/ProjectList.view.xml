<mvc:View controllerName="com.projectone.projectoneui.controller.ProjectList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Table
            id="projectTable"
            items="{project>/Projects}"
            noDataText="No projects found"
            growing="true">
            <headerToolbar>
                <Toolbar id="tableHeaderToolbar">
                    <Title id="tableTitle" text="Projects" level="H2" />
                </Toolbar>
            </headerToolbar>
            <columns>
                <Column id="colName">
                    <Text id="colNameText" text="Name" />
                </Column>
                <Column id="colStatus">
                    <Text id="colStatusText" text="Status" />
                </Column>
                <Column id="colOwner">
                    <Text id="colOwnerText" text="Owner" />
                </Column>
                <Column id="colPriority">
                    <Text id="colPriorityText" text="Priority" />
                </Column>
                <Column id="colProgress" hAlign="End">
                    <Text id="colProgressText" text="Progress" />
                </Column>
            </columns>
            <items>
                <ColumnListItem id="projectListItem" type="Navigation" press="onProjectPress">
                    <cells>
                        <ObjectIdentifier id="cellName" title="{project>Name}" />
                        <ObjectStatus id="cellStatus" text="{project>Status}" state="{project>StatusState}" />
                        <Text id="cellOwner" text="{project>Owner}" />
                        <Text id="cellPriority" text="{project>Priority}" />
                        <ProgressIndicator
                            id="cellProgress"
                            percentValue="{project>Progress}"
                            displayValue="{project>Progress}%"
                            showValue="true" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>