<mvc:View controllerName="com.projectone.projectoneui.controller.detail.ProjectDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:m="sap.m"
    xmlns="sap.uxap">
    <m:Page id="detailPage" title="{i18n>detailPageTitle}" showNavButton="true" navButtonPress="onNavBack">
    <ObjectPageLayout id="objectPage" showTitleInHeaderContent="true" useIconTabBar="true">
        <headerTitle>
            <ObjectPageDynamicHeaderTitle id="detailHeaderTitle">
                <expandedHeading>
                    <m:Title id="expandedTitle" text="{project>Name}" />
                </expandedHeading>
                <snappedHeading>
                    <m:Title id="snappedTitle" text="{project>Name}" />
                </snappedHeading>
                <expandedContent>
                    <m:ObjectStatus
                        id="expandedStatus"
                        text="{project>Status}"
                        state="{ path: 'project>Status', formatter: '.formatter.formatStatusState' }" />
                </expandedContent>
                <snappedContent>
                    <m:ObjectStatus
                        id="snappedStatus"
                        text="{project>Status}"
                        state="{ path: 'project>Status', formatter: '.formatter.formatStatusState' }" />
                </snappedContent>
                <actions>
                    <m:Select
                        id="sectionPicker"
                        tooltip="{i18n>sectionPickerTooltip}"
                        items="{mProjectDetail>/sectionOptions}"
                        change="onSectionPick">
                        <core:Item id="sectionPickerItem" key="{mProjectDetail>key}" text="{mProjectDetail>text}" />
                    </m:Select>
                    <m:Button
                        id="btnEditProject"
                        text="{i18n>btnEditProject}"
                        type="Emphasized"
                        visible="{= !${mProjectDetail>/editMode} }"
                        press="onEditProject" />
                    <m:Button
                        id="btnSaveProject"
                        text="{i18n>btnSaveProject}"
                        type="Emphasized"
                        visible="{mProjectDetail>/editMode}"
                        press="onSaveProject" />
                    <m:Button
                        id="btnCancelProject"
                        text="{i18n>btnCancelProject}"
                        visible="{mProjectDetail>/editMode}"
                        press="onCancelProject" />
                </actions>
            </ObjectPageDynamicHeaderTitle>
        </headerTitle>

        <headerContent>
            <m:FlexBox id="headerAttributesBox" wrap="Wrap">
                <m:VBox id="headerOwnerBox" class="sapUiMediumMarginEnd">
                    <m:ObjectAttribute id="headerOwner" title="{i18n>columnOwner}" text="{project>Owner}" />
                    <m:ObjectAttribute id="headerOwnerEmail" title="{i18n>columnOwnerEmail}" text="{project>OwnerEmail}" />
                </m:VBox>
                <m:VBox id="headerPriorityBox" class="sapUiMediumMarginEnd">
                    <m:ObjectAttribute id="headerPriority" title="{i18n>columnPriority}" text="{project>Priority}" />
                </m:VBox>
                <m:VBox id="headerDatesBox" class="sapUiMediumMarginEnd">
                    <m:ObjectAttribute id="headerStartDate" title="{i18n>columnStartDate}" text="{ path: 'project>StartDate', formatter: '.formatter.formatDate' }" />
                    <m:ObjectAttribute id="headerEndDate" title="{i18n>columnEndDate}" text="{ path: 'project>EndDate', formatter: '.formatter.formatDate' }" />
                </m:VBox>
                <m:VBox id="headerProgressBox">
                    <m:Label id="headerProgressLabel" text="{i18n>columnProgress}" />
                    <m:ProgressIndicator
                        id="headerProgress"
                        width="12rem"
                        percentValue="{project>Progress}"
                        displayValue="{= ${project>Progress} + '%'}"
                        state="{ path: 'project>Status', formatter: '.formatter.formatStatusState' }"
                        showValue="true" />
                </m:VBox>
            </m:FlexBox>
        </headerContent>

        <sections>
            <ObjectPageSection id="infoSection" title="{i18n>detailInfoPanelTitle}">
                <subSections>
                    <ObjectPageSubSection id="infoSubSection">
                        <blocks>
                            <f:SimpleForm id="infoForm" editable="true" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" labelSpanS="12">
                                <m:Label id="labelShortDescriptionEdit" text="{i18n>detailShortDescriptionTitle}" />
                                <m:Input id="inputShortDescription" visible="{mProjectDetail>/editMode}" value="{project>ShortDescription}" />
                                <m:Label id="labelShortDescription" text="{i18n>detailShortDescriptionTitle}" />
                                <m:Text id="textShortDescription" visible="{= !${mProjectDetail>/editMode} }" text="{project>ShortDescription}" />

                                <m:Label id="labelLongDescriptionEdit" text="{i18n>detailLongDescriptionTitle}" />
                                <m:TextArea id="inputLongDescription" visible="{mProjectDetail>/editMode}" rows="4" value="{project>LongDescription}" />
                                <m:Label id="labelLongDescription" text="{i18n>detailLongDescriptionTitle}" />
                                <m:Text id="textLongDescription" visible="{= !${mProjectDetail>/editMode} }" text="{project>LongDescription}" />
                            </f:SimpleForm>
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>

            <ObjectPageSection id="tasksSection" title="{i18n>detailTasksSectionTitle}">
                <subSections>
                    <ObjectPageSubSection id="tasksSubSection">
                        <blocks>
                            <core:Fragment fragmentName="com.projectone.projectoneui.view.fragment.TasksSection" type="XML" />
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
        </sections>
    </ObjectPageLayout>
    </m:Page>
</mvc:View>
